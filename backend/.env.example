PORT=3001
AWS_REGION=ap-south-1
S3_BUCKET=your-private-bucket-name
AWS_ACCESS_KEY_ID=replace-with-your-iam-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-your-iam-secret-access-key
S3_PREFIX=cloud-drive
ALLOWED_ORIGIN=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:3002,http://localhost:3002
MAX_FILE_BYTES=104857600

# Supabase server-side token verification only. Never put this service secret in the frontend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-server-side-supabase-secret
